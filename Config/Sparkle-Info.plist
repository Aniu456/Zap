<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  发布工作流会复制这份文件，并把公钥写入 SUPublicEDKey。
	  本地构建沿用下面的 appcast.xml。发布时按架构改成
	  appcast-apple-silicon.xml 或 appcast-intel.xml。
	  不要把 EdDSA 私钥写进仓库。
	-->
	<key>SUFeedURL</key>
	<string>https://github.com/Aniu456/Zap/releases/latest/download/appcast.xml</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
